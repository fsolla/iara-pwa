{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    // Harness MCP da Iara — seleção sobre os globais
    // (~/.config/opencode/opencode.jsonc). O conjunto habilitado (jina,
    // playwright) é herdado dos globais por design; aqui se declaram os MCPs
    // locais do próprio repo.
    //
    // forgejo: re-homed do global em OPS92 (era herdado, agora local) — tracker
    // de Issues no Forgejo.
    "forgejo": {
      "type": "local",
      "command": ["/home/fsolla/.local/bin/forgejo-mcp", "--transport", "stdio", "--url", "https://git.solla.dev"],
      "environment": {
        "FORGEJO_ACCESS_TOKEN": "{env:FORGEJO_API_TOKEN}",
        "FORGEJO_USER_AGENT": "forgejo-mcp/2.33.0 (opencode, fsolla)"
      },
      "enabled": true
    }
    // postgres: o global apontava pro banco do teqo; Iara é local-first sem
    // backend — não faz sentido (removido em OPS92, global já não expõe).
    // stalwart: e-mail pessoal; fora do fluxo de dev da Iara (Issue #5 dela).
    //   — pin removido em OPS92 (global já não expõe stalwart), mas decisão
    //   persiste: não re-adicionar stalwart neste repo.
    // penpot: config de repo do teqo (design); sem fluxo de design na Iara —
    // nem chega a carregar, então não há entrada aqui.
    // github: fluxo de PR/CI voltou para o GitHub (OPS1), mas é dirigido por
    // scripts (`bun run pr`, `github-pr-automerge.mjs`, configure) — o MCP
    // github continua desligado; o `forgejo` MCP é o tracker de Issues.
  },
  "provider": {
    "cheapest-inference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cheapest Inference",
      "options": {
        "baseURL": "https://api.cheapestinference.com/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "mimo-v2.5": {
          "name": "MiMo v2.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    }
  }
}
