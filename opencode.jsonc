{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    // Harness MCP da Iara — seleção sobre os globais
    // (~/.config/opencode/opencode.jsonc). O conjunto habilitado (forgejo,
    // playwright, jina) é herdado dos globais por design; aqui se desligam os
    // que NÃO devem carregar, para ninguém re-adicionar por engano.
    //
    // postgres: o global aponta pro banco do teqo; Iara é local-first sem
    // backend — não faz sentido no desenvolvimento da Iara.
    "postgres": { "enabled": false },
    // stalwart: e-mail pessoal; fora do fluxo de dev da Iara.
    "stalwart": { "enabled": false }
    // penpot: config de repo do teqo (design); sem fluxo de design na Iara —
    // nem chega a carregar, então não há entrada aqui.
    // github: fluxo de PR/CI voltou para o GitHub (OPS1), mas é dirigido por
    // scripts (`bun run pr`, `github-pr-automerge.mjs`, configure) — o MCP
    // github continua desligado; o `forgejo` MCP é o tracker de Issues.
  },
  "provider": {
    "cheapest-inference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cheapest Inference",
      "options": {
        "baseURL": "https://api.cheapestinference.com/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "mimo-v2.5": {
          "name": "MiMo v2.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    }
  }
}
