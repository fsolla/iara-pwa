{
  "name": "iara-pwa",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gate": "bun run lint && bun run build && bun run test:unit",
    "test:unit": "bun test tests/unit",
    "test:e2e": "playwright test",
    "worktree": "node scripts/worktree.mjs",
    "issue": "node scripts/issue.mjs",
    "pr": "node scripts/pr.mjs",
    "agent:claim": "node scripts/agent-claim.mjs",
    "agent:register": "node scripts/agent-register.mjs",
    "agent:ready": "node scripts/agent-ready.mjs",
    "agent:file-miss": "node scripts/agent-file-miss.mjs",
    "agent:status": "node scripts/agent-status.mjs",
    "agent:promote-related": "node scripts/agent-promote-related-on-merge.mjs",
    "pr:automerge": "node scripts/forgejo-pr-automerge.mjs",
    "issue:transition": "node scripts/forgejo-issue-transition.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.14",
    "@assistant-ui/react-markdown": "^0.14.10",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "license": "AGPL-3.0",
  "description": "Iara — chat PWA local-first para falar com o seu assistente de IA (ZeroClaw e gateways compativeis). Configure URL e key e converse.",
  "author": "Amana",
  "repository": {
    "type": "git",
    "url": "https://git.solla.dev/amana/iara-pwa.git"
  }
}
